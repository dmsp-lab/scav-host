# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# --- Which optional services to run -----------------------------------------
# Laptop: "localdb" runs a throwaway Postgres in Docker.
# Roommate's server: remove localdb (use his database), add "tunnel" once Cloudflare is set up.
COMPOSE_PROFILES=localdb

# --- Database ----------------------------------------------------------------
# Laptop default (the localdb container):
DATABASE_URL=postgres://scav:scav@db:5432/scav
# On the server, point at your roommate's Postgres (13 or newer), e.g.:
# DATABASE_URL=postgres://scav_app:CHANGE_ME@192.168.1.50:5432/friendsgiving
# Use host.docker.internal instead of an IP if Postgres runs on the same machine as Docker.
DATABASE_SSL=false

# --- Sign-in -----------------------------------------------------------------
# Players pick their name and type PARTY_CODE. The Game Master uses ADMIN_CODE.
PARTY_CODE=gobble
ADMIN_CODE=change-me-gamemaster
ADMIN_NAME=Game Master
# Long random string; generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Public address ----------------------------------------------------------
# Exactly the URL people type in their browser (scheme + host + port, no trailing slash).
# Upload links are signed for this address, so it must match.
#   Laptop:                 http://localhost:8080
#   Phones on your Wi-Fi:   http://192.168.x.x:8080   (your computer's LAN IP)
#   Live site:              https://friendsgiving.example.com
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false

# --- Media storage (SeaweedFS) ------------------------------------------------
# Any values work; they're used between the app and its own storage container.
S3_ACCESS_KEY=scavapp
S3_SECRET_KEY=change-me-storage-secret

# Upload limits. Cloudflare's free plan rejects request bodies over 100 MB,
# so keep videos under that when using the tunnel (ask people to record in 1080p).
MAX_IMAGE_MB=25
MAX_VIDEO_MB=95

# --- Cloudflare tunnel (server only) -----------------------------------------
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install token.
TUNNEL_TOKEN=

# --- Images ------------------------------------------------------------------
# Leave as-is to build locally. To run the images GitHub Actions publishes instead:
# IMAGE_PREFIX=ghcr.io/dmsp-lab/scav-host
# IMAGE_TAG=latest
