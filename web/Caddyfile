# The single front door: serves the React app, proxies /api to the API,
# and /scav-media/* to SeaweedFS for presigned photo/video uploads and downloads.
# HTTPS comes from the Cloudflare tunnel (or isn't needed on your laptop), so Caddy speaks plain HTTP.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000}
	}

	# Path must match S3_BUCKET. Caddy keeps the original Host header, which the presigned signature covers.
	handle /scav-media/* {
		reverse_proxy {$S3_UPSTREAM:seaweedfs:8333} {
			flush_interval -1
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	handle {
		root * {$WEB_ROOT:/srv}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
